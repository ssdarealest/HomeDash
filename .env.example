# HomeDash Environment Configuration

# -----------------------------------------------------------------------------
# Core Server & Network
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# -----------------------------------------------------------------------------
# Database (PostgreSQL 17+)
# -----------------------------------------------------------------------------
POSTGRES_DB=homedash
POSTGRES_USER=homedash
POSTGRES_PASSWORD=homedash_secret_password
DATABASE_URL=postgres://homedash:homedash_secret_password@localhost:5432/homedash

# -----------------------------------------------------------------------------
# Cache & Task Queue (Valkey / Redis)
# -----------------------------------------------------------------------------
VALKEY_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Object Storage (MinIO / S3)
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadminpassword
MINIO_DEFAULT_BUCKET=homedash-assets

# -----------------------------------------------------------------------------
# Authentication & Cryptography
# -----------------------------------------------------------------------------
# Generate via: openssl rand -base64 32
JWT_SECRET=homedash_super_secret_jwt_key_at_least_32_bytes_long
JWT_EXPIRES_IN=7d

# WebAuthn / Passkeys
WEBAUTHN_RP_NAME="HomeDash Family OS"
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# Caregiver Temporary Access
CAREGIVER_TOKEN_DEFAULT_TTL_HOURS=8
