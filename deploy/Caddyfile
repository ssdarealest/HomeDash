{
    admin off
}

{$SERVER_NAME:localhost} {
    # Security Headers
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    # Realtime SSE stream endpoints with unbuffered flush
    handle /api/v1/realtime/stream {
        reverse_proxy server:3000 {
            flush_interval -1
        }
    }

    handle /realtime/stream {
        reverse_proxy server:3000 {
            flush_interval -1
        }
    }

    # API and Backend WebSocket routing
    handle /api/* {
        reverse_proxy server:3000
    }

    handle /ws {
        reverse_proxy server:3000
    }

    handle /health {
        reverse_proxy server:3000
    }

    handle /openapi.json {
        reverse_proxy server:3000
    }

    # Web client static assets with SPA routing fallback
    handle {
        root * /srv/web/dist
        try_files {path} /index.html
        file_server
    }
}
